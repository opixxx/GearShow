# ===========================================
# GearShow 환경변수 설정 예시
# 이 파일을 복사하여 .env 파일을 생성하세요: cp .env.example .env
# ===========================================

# JWT
JWT_SECRET=your-256-bit-secret-key-here-change-in-production-env

# Kakao OAuth
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/login/kakao

# Apple OAuth
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=

# Database
# 로컬 개발: docker-compose 의 mysql 컨테이너에 호스트에서 접속
# 운영(EC2): RDS 엔드포인트로 교체 — jdbc:mysql://<rds-endpoint>:3306/gearshow?...
DB_URL=jdbc:mysql://localhost:3306/gearshow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
DB_USERNAME=gearshow
DB_PASSWORD=gearshow

# AWS S3
AWS_S3_REGION=ap-northeast-2
AWS_S3_ACCESS_KEY=your-access-key
AWS_S3_SECRET_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket
AWS_S3_CDN_URL=https://your-cdn-url
AWS_S3_ENDPOINT=

# Kafka
# 로컬 개발: IDE 에서 backend 실행 → docker-compose 의 kafka 를 호스트 localhost:9092 로 접속
# 운영(EC2): docker-compose.prod.yml 의 backend 서비스가 environment 로 gearshow-kafka:29092 를 강제 주입하므로
#           EC2 .env 에는 이 두 값을 설정하지 않아도 된다 (설정해도 compose environment 가 우선).
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Tripo 3D 모델 생성 API
# 로컬 실연동(옵션 튜닝 등) 시:
#   1) TRIPO_ENABLED=true 로 켠다 — false 면 FakeModelGenerationClient 가 활성화된다
#   2) 유효한 TRIPO_API_KEY 를 채운다 (실 계정 크레딧이 소모된다)
#   3) 위 'AWS S3' 섹션의 4개 값(REGION/ACCESS_KEY/SECRET_KEY/BUCKET/CDN_URL) 도 dev 자격증명으로 채운다
#      — DownloadAndMirrorService 가 Tripo GLB 를 받아 S3 PUT 하는 단계가 필수다
TRIPO_ENABLED=false
TRIPO_API_KEY=

# Tripo 옵션 튜닝 노브 (선택) — 모두 application-local.yml 에 default 가 명시돼 있다.
# 환경변수가 yml 보다 우선이므로, 아래 줄의 주석을 풀면 yml 값을 override 한다.
# IDE 실행 구성에서 환경변수만 갈아끼우면 백엔드 재기동만으로 옵션 실험이 가능하다.
# 활성 상태로 두면 yml 변경이 반영되지 않는 함정이 생기므로 평소에는 주석으로 둔다.
# APP_TRIPO_API_TEXTURE_QUALITY=detailed
# APP_TRIPO_API_FACE_LIMIT=200000
# APP_TRIPO_API_ORIENTATION=align_image
# TRIPO_MODEL_VERSION=v3.0-20250812
