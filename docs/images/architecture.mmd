flowchart TB
    app["Flutter App"]

    api["<b>api</b><br/>HTTP API<br/>WebSocket(STOMP)<br/>Outbox Relay"]

    kafka[("Kafka")]
    mysql[("MySQL<br/>(AWS RDS)")]
    redis[("Redis<br/>락 · 세마포어 · 대기열")]

    worker["<b>worker</b><br/>3D 생성 Consumer<br/>Tripo 폴링 · 복구 배치"]

    tripo["Tripo 3D API"]
    s3[("AWS S3")]

    app -->|"REST · STOMP"| api
    api -->|"Outbox 이벤트"| kafka
    api --- mysql
    api --- redis
    kafka -->|"3D 생성 요청"| worker
    mysql --- worker
    redis --- worker
    worker -->|"생성 요청 · 폴링"| tripo
    worker -->|"GLB 저장"| s3

    classDef app fill:#eef6ff,stroke:#3b82f6,color:#0f172a
    classDef proc fill:#ecfdf5,stroke:#10b981,color:#0f172a
    classDef store fill:#f8fafc,stroke:#64748b,color:#0f172a
    classDef ext fill:#fff7ed,stroke:#f97316,color:#0f172a
    class app app
    class api,worker proc
    class kafka,mysql,redis,s3 store
    class tripo ext
